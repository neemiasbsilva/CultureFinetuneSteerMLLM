# Python bytecode, build products, and tooling caches
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets: only the template is shared
.env
!.env.example

# Experiment artifacts. The pipeline regenerates all of these, and the
# checkpoint tree runs to hundreds of gigabytes.
checkpoints/**
!checkpoints/.gitkeep
outputs/**
!outputs/.gitkeep
logs/**
!logs/.gitkeep
mlruns/**
!mlruns/.gitkeep
mlflow.db*
*.log

# Corpora. data/ is a symlink to an external dataset root that is licensed
# separately and never redistributed here.
/data
*.csv
*.parquet

# Model weights never belong in git
*.safetensors
*.gguf
*.bin
*.pt

# Editors and OS
.vscode/
.idea/
.claude/
.DS_Store
