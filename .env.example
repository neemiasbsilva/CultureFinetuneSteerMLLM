# Copy to .env and fill in values

# Data paths (relative to project root)
PERCEPTSENT_IMAGES_DIR=../perceptsent/images
AGREEMENT_CSV=../multimodal-LLMs-see-sentiment/data/agreement_p5_sigma3.csv
CULTURE_CONTEXT_JSONL=../CultureLLM/data/culture_context.jsonl
CULTURELLM_DATA_DIR=../CultureLLM/data
EXISTING_CAPTIONS_CSV=../multimodal-LLMs-see-sentiment/reports/percept_dataset_alpha5_p5.csv
PERCEPTIONS_VOCAB_JSON=../mllm-persona-evaluation/data/unique_perceptions.json

# Distributional track (Cao et al. 2025): where the copied SimLLMCultureDist splits live
DISTRIBUTIONAL_RAW_DIR=data/raw/distributional

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_TRAINING=emnlp26_culturevlm_training
MLFLOW_EXPERIMENT_ANNOTATION=emnlp26_culturevlm_annotation

# Ollama (for annotation inference)
OLLAMA_BASE_URL=http://localhost:11434
ANNOTATION_MAX_CONCURRENT=2

# HuggingFace token (if needed for gated models)
HF_TOKEN=
